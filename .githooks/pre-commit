#!/usr/bin/env bash
# Sync .cursor/rules, AGENTS.md, Copilot, Windsurf, Antigravity from
# .claude/shared.md + .claude/agents/.

REPO_ROOT="$(git rev-parse --show-toplevel)"

if ! python "$REPO_ROOT/sync-ai-configs.py"; then
  echo "⚠  sync-ai-configs.py failed — committing without regenerating AI configs." >&2
  exit 0
fi

git add \
  "$REPO_ROOT/.cursor/rules/" \
  "$REPO_ROOT/.github/copilot-instructions.md" \
  "$REPO_ROOT/AGENTS.md" \
  "$REPO_ROOT/.windsurfrules" \
  "$REPO_ROOT/.agents/skills/"
